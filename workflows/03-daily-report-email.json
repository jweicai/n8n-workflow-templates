{
  "name": "Daily Report → Email Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1-5"
            }
          ]
        }
      },
      "id": "c3d5e7f9-0001-4000-8000-000000000001",
      "name": "Weekdays 8:00 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-200, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.your-app.example.com/stats/daily",
        "options": {}
      },
      "id": "c3d5e7f9-0002-4000-8000-000000000002",
      "name": "Fetch yesterday's stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "s1",
              "name": "signups",
              "value": "={{ $json.signups || 0 }}",
              "type": "number"
            },
            {
              "id": "s2",
              "name": "revenue",
              "value": "={{ $json.revenue || 0 }}",
              "type": "number"
            },
            {
              "id": "s3",
              "name": "report_date",
              "value": "={{ $now.minus(1, 'days').toFormat('yyyy-MM-dd') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c3d5e7f9-0003-4000-8000-000000000003",
      "name": "Build report data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [200, 0]
    },
    {
      "parameters": {
        "jsCode": "const d = items[0].json;\nconst trend = d.signups >= 10 ? '📈' : '📉';\nreturn [{ json: { subject: `Daily report — ${d.report_date}`, text: `${trend} Signups: ${d.signups}\\n💰 Revenue: $${d.revenue}` } }];"
      },
      "id": "c3d5e7f9-0004-4000-8000-000000000004",
      "name": "Format email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.your-mailer.example.com/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: 'founder@yourco.com', subject: $json.subject, text: $json.text }) }}",
        "options": {}
      },
      "id": "c3d5e7f9-0005-4000-8000-000000000005",
      "name": "Send email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [620, 0]
    }
  ],
  "connections": {
    "Weekdays 8:00 AM": {
      "main": [[{ "node": "Fetch yesterday's stats", "type": "main", "index": 0 }]]
    },
    "Fetch yesterday's stats": {
      "main": [[{ "node": "Build report data", "type": "main", "index": 0 }]]
    },
    "Build report data": {
      "main": [[{ "node": "Format email", "type": "main", "index": 0 }]]
    },
    "Format email": {
      "main": [[{ "node": "Send email", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
